{
  "name": "chrontab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "build": "node scripts/generate-icons.mjs && node scripts/update-notices.mjs && vite build",
    "test:browser": "node tests/browser-check.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:calendar": "node tests/calendar-browser.mjs",
    "pack:crx": "node scripts/package-crx.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "test:e2e": "pnpm test:browser && pnpm test:calendar"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdi/js": "^7.4.47",
    "@mui/material": "^9.5.0",
    "date-holidays": "^3.37.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
